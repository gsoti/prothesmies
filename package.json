{
  "name": "prothesmies",
  "version": "1.1.2",
  "description": "Deterministic Greek legal deadline calculators",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "generate:admin-nomothesia": "node scripts/generate-admin-nomothesia.mjs",
    "test": "vitest",
    "test:lawcase": "LAWCASE_LIVE=1 vitest run tests/lawcase-live.test.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@gsoti/prothesmies": "github:gsoti/ls-prothesmies",
    "@types/node": "^22.0.0",
    "fast-check": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
