{
  "name": "prothesmies",
  "version": "1.0.0",
  "description": "Prothesmies application with Vercel Postgres",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@gsoti/prothesmies": "github:gsoti/ls-prothesmies",
    "@vercel/postgres": "^0.10.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
